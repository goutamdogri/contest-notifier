[Unit]
Description=Contest Notifier - sync upcoming coding contests to Google Calendar and Tasks
Documentation=file:/home/goutamdogri/Projects/fun_project/contest_notifier/README.md
After=network-online.target
Wants=network-online.target

# Raise a loud desktop notification instead of failing silently if a run ever
# fails to start (203/EXEC, crash, non-zero exit).
OnFailure=contest-notifier-failure.service

[Service]
Type=oneshot
WorkingDirectory=/home/goutamdogri/Projects/fun_project/contest_notifier

# Use the system Node rather than an nvm version. nvm paths are version-pinned
# (e.g. .../node/v24.13.0/bin/node) and vanish on upgrade, which silently broke
# this service with status=203/EXEC for a week. /usr/bin/node is stable.
ExecStart=/usr/bin/node --disable-warning=ExperimentalWarning /home/goutamdogri/Projects/fun_project/contest_notifier/dist/cli.js run --non-interactive --quiet

# A slow or flaky network should not permanently disable the timer.
TimeoutStartSec=240

# Reasonable hardening. Left deliberately light so the run cannot fail because of
# an unexpected write location; the only writes are the token dir and state dir.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=default.target
